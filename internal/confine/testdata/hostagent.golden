(version 1)
(allow default)

(deny network-outbound)
(allow network-outbound
  (remote tcp "localhost:32201")
  (literal "/state/boxes/fixture/run/net.sock")
  (subpath "/tmp/instance \"quoted\"\\path"))

(deny network-bind)
(allow network-bind
  (local tcp "localhost:32201")
  (local tcp "*:10100")
  (subpath "/tmp/instance \"quoted\"\\path"))

(deny file-write*)
(deny file-read*)
(deny process-exec*)
(deny appleevent-send job-creation)
(deny mach-lookup)

; System libraries, framework resources and dyld shared caches.
(allow file-read*
  (subpath "/System/Library")
  (subpath "/System/Cryptexes/OS")
  (subpath "/System/Volumes/Preboot/Cryptexes/OS")
  (subpath "/usr/lib")
  (literal "/")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/etc")
  (literal "/var")
  (literal "/private/etc/localtime")
  (subpath "/private/var/db/timezone")
  (subpath "/usr/share/zoneinfo"))
(allow file-read-metadata
  (literal "/System")
  (literal "/usr")
  (literal "/usr/share")
  (literal "/private")
  (literal "/private/etc")
  (literal "/private/var")
  (literal "/private/var/db")
  (literal "/tmp"))
; Suppress the optional dyld tracing-device probe.
(deny file-read-data file-write-data (literal "/dev/dtracehelper") (with no-log))
(define entrypoint (param "BOX_PROBE"))
(allow file-read* (literal entrypoint))
(allow process-exec (require-all (process-attribute is-platform-binary) (literal entrypoint)))
(allow file-write* (subpath "/tmp/instance \"quoted\"\\path"))

; Virtualization.framework starts the VM through its XPC service.
(allow mach-lookup (global-name "com.apple.Virtualization.VirtualMachine"))
; Newer Virtualization.framework uses dirhelper to resolve the user cache directory.
(allow mach-lookup (global-name "com.apple.bsd.dirhelper"))
; The cache-directory lookup also resolves the user's group membership.
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.membership"))
; macOS account resolution supplies the local user to Lima and OpenSSH.
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))

; Lima resolves these executables on PATH and spawns them in this profile.
(define host-tools
  (list "/usr/bin/ssh" "/usr/bin/sw_vers" "/usr/sbin/ioreg"
        "/usr/sbin/system_profiler" "/bin/sh" "/bin/bash"))
(allow process-exec (apply literal host-tools))
(allow file-read*
  (apply literal host-tools)
  (literal "/bin")
  (literal "/sbin")
  (literal "/usr/bin")
  (literal "/usr/sbin")
  (literal "/dev/tty")
  (literal "/private/etc/resolv.conf")
  (literal "/private/var/run/resolv.conf")
  (literal "/private/etc/ssh/ssh_config")
  (subpath "/private/etc/ssh/ssh_config.d")
  (subpath "/usr/share/icu")
  (subpath "/usr/share/locale"))
(allow file-read-metadata (literal "/private/var/run") (literal "/private/etc/ssh"))
(allow file-read-metadata (literal "/opt/tools"))
(allow file-read-metadata (literal "/opt"))
(allow file-read* (literal "/opt/bin/limactl"))
(allow file-read-metadata (literal "/opt/bin"))
(allow file-read-metadata (literal "/opt"))
(deny file-read* (subpath "/Users/fixture"))
(allow file-read* (subpath "/state/lima/_config") (subpath "/tmp/instance \"quoted\"\\path") (literal "/opt/tools/limactl"))
(allow file-read-data (literal "/state/lima"))
(allow file-read-metadata (literal "/state/lima"))
(allow file-read-metadata (literal "/state"))
(allow file-read-metadata (literal "/state/boxes/fixture/run/net.sock"))
(allow file-read-metadata (literal "/state/boxes/fixture/run"))
(allow file-read-metadata (literal "/state/boxes/fixture"))
(allow file-read-metadata (literal "/state/boxes"))
(allow file-read-metadata (literal "/state"))
(allow file-write* (literal "/dev/null"))
(allow file-write* (literal "/state/lima/_config/networks.yaml"))
(deny file-write* (literal "/tmp/instance \"quoted\"\\path/lima.yaml"))
(allow process-exec (literal "/opt/tools/limactl"))
