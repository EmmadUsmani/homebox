(version 1)
(allow default)

(deny network-bind)
(allow network-bind
  (local tcp "localhost:23001")
  (local tcp "localhost:23101")
  (local tcp "*:2201")
  (local udp "localhost:23101")
)

(deny file-write*)
(deny file-read-data file-write-data (literal "/dev/dtracehelper") (with no-log))
(deny process-exec*)
(deny appleevent-send job-creation)
(deny mach-lookup
  (global-name-regex #"^com[.]apple[.](lsd|launchservices|coreservices[.]launchservicesd|runningboard)([.]|$)"))
(define entrypoint (param "BOX_PROBE"))
(allow process-exec (require-all (process-attribute is-platform-binary) (literal entrypoint)))
(allow file-write* (subpath "/state/boxes/fixture/run"))
(deny process-fork)
(deny file-read*)
(allow file-read*
  (subpath "/System")
  (literal "/")
  (literal "/etc")
  (literal "/var")
  (subpath "/usr/lib")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/usr/share/zoneinfo")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal entrypoint))
(allow file-read* (subpath "/state/boxes/fixture/run") (literal "/opt/tools/box"))
(allow file-read-metadata (literal "/tmp"))
(allow file-read-metadata (literal "/state/boxes/fixture"))
(allow file-read-metadata (literal "/state/boxes"))
(allow file-read-metadata (literal "/state"))
(allow file-read-metadata (literal "/opt/tools"))
(allow file-read-metadata (literal "/opt"))
